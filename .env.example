# PassivMOS Webapp Configuration (optional)

# Server settings
HOST=0.0.0.0
PORT=8000

# Scraper settings
SCRAPE_INTERVAL=300  # seconds (5 minutes)

# Cache settings
CACHE_DIR=data/cache

# Sessions directory
SESSIONS_DIR=sessions

# Comma-separated trusted browser origins. Leave empty for same-origin only.
CORS_ORIGINS=https://your-domain.example
# Set true only when the site is served over HTTPS.
SESSION_COOKIE_SECURE=true
